# Server Environment Variables (development)
# Copy this file to .env and fill in your values. It lists only the variables
# that server code actually reads — see src/config/env.js for built-in defaults.

PORT=5000
NODE_ENV=development

# Database — Supabase is the only backend (required in production, optional here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key
# Service/secret key for API-mode endpoints that bypass RLS. Keep it secret;
# never commit a real value (see .gitignore — only *.example files are tracked).
SUPABASE_SERVICE_ROLE_KEY=

# JWT (HS256). Use long random values in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-jwt-secret-change-me-1234567890
JWT_EXPIRE=30m                # short by design now that the per-request blacklist gate kills revoked sessions instantly (code fallback without this var is 7d — see docs/SECURITY.md)
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1234567890
JWT_REFRESH_EXPIRE=30d

# CORS — explicit origins, comma-separated. Never use "*" in production
# (the server refuses to boot with it when NODE_ENV=production).
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Platform (business knobs)
PLATFORM_NAME=Veloxora
PLATFORM_COMMISSION_RATE=0.05
TOKENS_PER_USD=100          # parallel token pricing: 100 tokens = $1.00; omit for the same default

# Payments — master switch for /api/payments/deposit and /process (clean 503 while off).
PAYMENTS_ENABLED=false
# Stripe keys are listed for the incoming gateway integration but unused by
# server code until it ships:
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Security / ops knobs read by the server
BCRYPT_ROUNDS=12

# Windows agent (informational to the API service)
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://api.example.com/updates
