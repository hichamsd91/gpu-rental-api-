# Server Environment Variables (development)
# Copy this file to .env and fill in your values. It lists only the variables
# that server code actually reads — see src/config/env.js for built-in defaults.

PORT=5000
NODE_ENV=development

# Database — Supabase is the only backend (required in production, optional here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key
# Service/secret key for API-mode endpoints that bypass RLS. Keep it secret;
# never commit a real value (see .gitignore — only *.example files are tracked).
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase naming is also accepted (either secret name works):
# SUPABASE_SECRET_KEY=sb_secret_...
# Optional JWKS endpoint for verifying Supabase-issued tokens:
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# JWT (HS256). Use long random values in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-jwt-secret-change-me-1234567890
JWT_EXPIRE=30m                # short by design now that the per-request blacklist gate kills revoked sessions instantly (code fallback without this var is 7d — see docs/SECURITY.md)
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-1234567890
JWT_REFRESH_EXPIRE=30d

# CORS — explicit origins, comma-separated. Never use "*" in production
# (the server refuses to boot with it when NODE_ENV=production).
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Where the API sends users back after OAuth / email links. Without it the
# production URL below is used, which is wrong for local development.
FRONTEND_URL=http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Platform (business knobs)
PLATFORM_NAME=Veloxora
# Intentionally NO PLATFORM_COMMISSION_RATE variable — the rate (0%) is hardcoded in
# src/services/commissionService.js and mirrored in migration 003's settlement RPC. Veloxora takes
# no cut of a session: the provider keeps 100% and revenue comes from ads. Keep them in sync.
TOKENS_PER_USD=100          # parallel token pricing: 100 tokens = $1.00; omit for the same default

# Payments — master switch for /api/payments/deposit and /process (clean 503 while off).
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Security / ops knobs read by the server
BCRYPT_ROUNDS=12

# --- Social sign-in -------------------------------------------------------
# Strategies register ONLY when both id and secret are present; otherwise
# /api/auth/providers reports the provider as false and the routes answer 503.
# Callbacks must match the provider console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# --- Email (verification + password reset) --------------------------------
# The mailer detaches sends from the request; with no transport configured the
# links are logged instead of sent, so local flows stay testable.
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Veloxora <no-reply@example.com>

# --- Background sweeps (optional) -----------------------------------------
# Rental enforcer drives hourly settlement; keep-alive pings /health so the
# free Render instance does not cold-start mid-session.
RENTAL_ENFORCER=true
RENTAL_ENFORCER_INTERVAL_SEC=60
KEEP_ALIVE=false
KEEP_ALIVE_URL=http://localhost:5000/health

# --- Weekly payouts (0% commission economy) ------------------------------
# One transfer a week per provider keeps Stripe fees ~0.75% instead of ~30%
# on per-session transfers. Amounts are in USD.
PAYOUT_MINIMUM_USD=50        # unpaid net below this rolls over to next week
PAYOUT_HOLD_DAYS=7           # dispute window; a payout never lands sooner
PAYOUT_MAX_USD=5000          # anything above this is held for manual review
PLATFORM_USER_ID=00000000-0000-4000-8000-000000000001
# Absolute base URL of this API (links in emails) and the P2P signaling endpoint.
# APP_URL=https://api.example.com
# SIGNALING_URL=wss://api.example.com/signaling

# --- Windows agent (informational to the API service) ---------------------
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://api.example.com/updates
