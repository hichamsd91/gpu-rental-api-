# Server Environment Variables
# Copy this file to .env and fill in your values

# Database
MONGODB_URI=mongodb://localhost:27017/gpu_rental_platform
PORT=5000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-1234567890
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-1234567890
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Platform
PLATFORM_COMMISSION_RATE=0.15
PLATFORM_NAME=GPU Rental Platform

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session
SESSION_TIMEOUT_MINUTES=30
HEARTBEAT_INTERVAL_SECONDS=30

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@gpurental.com

# Security
BCRYPT_ROUNDS=12
ALLOWED_COMMANDS=start_session,end_session,get_stats,restart

# Windows Agent
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://api.gpurental.com/updates
