# Dependencies
node_modules/

# Environment files — every real .env file is ignored (exact name, and any
# variant like .env.production / .env.staging). The tracked templates are the
# *.example files, force-listed below. Never commit a real env file.
.env
.env.local
.env.*
!.env.example
!.env.production.example
!.env.staging.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Misc
*.pem
.vercel
.netlify
