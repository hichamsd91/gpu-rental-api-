# Staging environment template
NODE_ENV=staging
PORT=5001

# Database
MONGODB_URI=mongodb+srv://username:password@cluster-staging.mongodb.net/gpu_rental_platform_staging

# JWT
JWT_SECRET=replace-with-a-long-random-secret-for-staging
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-for-staging
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=https://staging.example.com,https://admin-staging.example.com,http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Platform
PLATFORM_NAME=Veloxora Staging
PLATFORM_COMMISSION_RATE=0.15

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session
SESSION_TIMEOUT_MINUTES=30
HEARTBEAT_INTERVAL_SECONDS=30

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_test_your_staging_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_staging_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_webhook_secret

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=staging@example.com
EMAIL_PASSWORD=replace-with-app-password
EMAIL_FROM=noreply@staging.example.com

# Security
BCRYPT_ROUNDS=12
ALLOWED_COMMANDS=start_session,end_session,get_stats,restart

# App metadata
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://staging.example.com/updates
