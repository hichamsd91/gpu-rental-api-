# Staging environment template (mirrors .env.production.example).

NODE_ENV=staging
PORT=5001

# Database — Supabase (point at a staging project or masked copy of production)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key

# JWT — long random values, distinct from the production pair
JWT_SECRET=replace-with-a-long-random-secret-for-staging
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-for-staging
JWT_REFRESH_EXPIRE=30d

# CORS — explicit origins only (never a bare "*")
CORS_ORIGIN=https://staging.example.com,https://admin-staging.example.com,http://localhost:3000
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Platform (business knobs)
PLATFORM_NAME=Veloxora Staging
# Intentionally NO PLATFORM_COMMISSION_RATE variable — the rate (5%) is hardcoded in src/services/commissionService.js and migration 003's RPC.
TOKENS_PER_USD=100

# Payments — staging stays off unless the integration is under test; then flip to true with test-mode keys.
PAYMENTS_ENABLED=false
# (No Stripe keys here: the gateway integration is not built yet; add test-mode keys only while it is under test.)

# Ops knobs read by the server
BCRYPT_ROUNDS=12

# Windows agent (informational)
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://staging.example.com/updates
