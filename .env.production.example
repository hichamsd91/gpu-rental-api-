# Production environment template.
# Copy to .env and fill in every value BEFORE deploy: with NODE_ENV=production
# the server refuses to boot without Supabase, valid JWT secrets, and an
# explicit CORS origin list (see src/config/env.js).

NODE_ENV=production
PORT=5000

# Database — Supabase is the only backend; missing it fails production boot.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=paste-your-publishable-or-anon-key
# Required: service/secret key for API-mode endpoints (bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key

# JWT — long random values required, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-very-long-random-secret-for-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-a-very-long-random-refresh-secret-for-production
JWT_REFRESH_EXPIRE=30d

# CORS — explicit https origins only. A bare "*" is rejected at production boot;
# include the admin console origin if it calls the API cross-origin.
CORS_ORIGIN=https://app.example.com,https://www.example.com,https://admin.example.com
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Platform (business knobs)
PLATFORM_NAME=Veloxora
PLATFORM_COMMISSION_RATE=0.05
TOKENS_PER_USD=100

# Payments — keep OFF until the Stripe gateway integration is deployed and tested.
# While off, deposit/process answer a clean 503 PAYMENTS_DISABLED; wallet/ledger reads stay live.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Ops knobs read by the server
BCRYPT_ROUNDS=12

# Windows agent (informational)
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://api.example.com/updates
