# Production environment template
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster-prod.mongodb.net/gpu_rental_platform_production

# JWT
JWT_SECRET=replace-with-a-very-long-random-secret-for-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-a-very-long-random-refresh-secret-for-production
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=https://app.example.com,https://www.example.com,https://admin.example.com
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Platform
PLATFORM_NAME=Veloxora
PLATFORM_COMMISSION_RATE=0.15

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session
SESSION_TIMEOUT_MINUTES=30
HEARTBEAT_INTERVAL_SECONDS=30

# Payment (Stripe)
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret

# Email
EMAIL_SERVICE=sendgrid
EMAIL_USER=apikey
EMAIL_PASSWORD=replace-with-production-email-token
EMAIL_FROM=noreply@example.com

# Security
BCRYPT_ROUNDS=12
ALLOWED_COMMANDS=start_session,end_session,get_stats,restart

# App metadata
AGENT_VERSION=1.0.0
AGENT_UPDATE_URL=https://api.example.com/updates
